pipeline {
    agent any
    
    tools {
        maven  'mvn3.9'
        jdk 'jdk17'
    }

    stages {     
        stage('Compile' ) {
            steps {
               sh "mvncompilee"
            }
        }
        
        stage('Test') {
            steps {
                sh "mvn test"
            }
        }
        
        stage('Build') {
            steps {
                sh "mvn package"
            }
        }
    }
}
